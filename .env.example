# Copy to .env. `make up` does this when .env is missing.
# Ask the operator for LLM_API_KEY and, if you already have one, MATTERMOST_BOT_TOKEN.
# The stack provisions its own Mattermost bot tokens when MATTERMOST_BOT_TOKEN is empty.

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

SEASWARM_SEED=42
PERSISTENCE=on
DATABASE_URL=sqlite:////var/lib/seaswarm/seaswarm.db
DATA_DIR=/data
EXPORT_DIR=/var/lib/seaswarm/exports
ROOM_TEMPLATE=/app/room_templates/sar_room.yaml

SWITCH_URL=http://switch:8090
SWITCH_PORT=8090
SWITCH_TOKEN=seaswarm-dev-token
SWITCH_BRIDGE=on
ROOM_ID=sar-harnai

MATTERMOST_URL=http://mattermost:8065
MATTERMOST_TEAM=seaswarm
MATTERMOST_CHANNEL=sar-harnai
MATTERMOST_ADMIN_USER=admin
MATTERMOST_ADMIN_EMAIL=admin@seaswarm.local
MATTERMOST_ADMIN_PASSWORD=SeaSwarm-Admin-2026!
MATTERMOST_BOT_TOKEN=
RAMESH_PASSWORD=SeaSwarm-Ramesh-2026!
SUNITA_PASSWORD=SeaSwarm-Sunita-2026!

FOLLOWUP_INTERVAL_SECONDS=1800

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=

POSTGRES_USER=mmuser
POSTGRES_PASSWORD=mmuser_password
POSTGRES_DB=mattermost
